# Bu faylni .env.local qilib nusxalang (.env.local hech qachon commit qilinmaydi).

# Django backend'ning SERVER (SSR/dev-proxy) ichidan ko'rinadigan manzili.
# Production'da bu odatda gunicorn'ning lokal manzili (127.0.0.1:8000),
# chunki Next.js va Django bir xil serverda ishlaydi (alohida server shart
# emas — CLAUDE.md rejasi).
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Saytning tashqi (brauzerga ko'rinadigan) manzili — SSR fetch'da
# `X-Forwarded-Proto`/`Host` header'lari va mutlaq URL yasashda ishlatiladi.
# Production'da https://more-movie.uz kabi bo'ladi.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_HOST=localhost:3000
SITE_PROTO=http
