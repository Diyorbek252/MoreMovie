# MORE-MOVIE — konfiguratsiya namunasi.
# Nusxa oling:  copy .env.example .env   (Windows)  /  cp .env.example .env  (Linux)
# Keyin SECRET_KEY ni o'zingiznikiga almashtiring:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

SECRET_KEY=bu-yerga-o-zingizning-maxfiy-kalitingizni-qo-ying
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Bo'sh = SQLite. Production'da PostgreSQL URL qo'ying.
DATABASE_URL=

SITE_NAME=MORE-MOVIE
SITE_TAGLINE=Cheksiz kino zavqi...
